rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMemberOf(groupId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // 一般使用者（LINE、Google…任一種登入）＝非訪客。
    // 訪客（guestLogin 發的 token 帶 guest claim）只能使用自己那個名字，不能建立、加入或退出群組。
    // 原名 isLineUser()，P14 之後登入方式不只 LINE，語意不變、改名
    function isMember() {
      return request.auth != null && request.auth.token.get('guest', false) != true;
    }

    // 身分對照表與帳號合併紀錄只給雲端函式（Admin SDK）讀寫，客戶端一律拒絕。
    // 沒有 match 到的路徑本來就預設拒絕，這裡明寫是為了讓意圖清楚，也方便測試
    match /identities/{id} {
      allow read, write: if false;
    }
    match /merges/{id} {
      allow read, write: if false;
    }
    match /mergeBackups/{id} {
      allow read, write: if false;
    }
    // 一次性連結碼（帶著登入狀態到外部瀏覽器用），只存雜湊，同樣只有雲端函式能讀寫
    match /linkCodes/{id} {
      allow read, write: if false;
    }

    // 成員新增一位虛擬成員：members 只多一人（arrayUnion 會加在最後），id 以 p_ 開頭
    // （LINE userId 不含底線，不會撞號），且 memberProfiles 只多這一筆並標記 placeholder
    function addsPlaceholder() {
      let before = resource.data;
      let after = request.resource.data;
      let newId = after.members[after.members.size() - 1];
      return request.auth.uid in before.members
        && after.diff(before).affectedKeys().hasOnly(['members', 'memberProfiles'])
        && after.members.size() == before.members.size() + 1
        && after.members.size() <= 50
        && after.members.hasAll(before.members)
        && newId[0:2] == 'p_'
        && after.memberProfiles.diff(before.memberProfiles).addedKeys().hasOnly([newId])
        && after.memberProfiles.diff(before.memberProfiles).affectedKeys().hasOnly([newId])
        && after.memberProfiles[newId].placeholder == true
        && after.memberProfiles[newId].name is string
        && after.memberProfiles[newId].name.size() >= 1
        && after.memberProfiles[newId].name.size() <= 20;
    }

    // 群組預算：沒有 budget，或 { amount: 正數, period: { type: 字串 } }（之後加 byCategory 時 hasOnly 要放寬）
    function validBudget() {
      let d = request.resource.data;
      return !('budget' in d)
        || (d.budget is map
            && d.budget.keys().hasOnly(['amount', 'period'])
            && d.budget.amount is number
            && d.budget.amount > 0
            && d.budget.amount < 1000000000000
            && d.budget.period is map
            && d.budget.period.type is string);
    }

    // 個人收款方式：本人可讀寫；其他登入者只能讀「公開顯示」的（列表查詢需帶 isPublic == true）
    match /users/{userId}/paymentMethods/{methodId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || resource.data.isPublic == true);
      allow create, update: if isMember()
        && request.auth.uid == userId
        && request.resource.data.providerId is string
        && request.resource.data.value is string
        && request.resource.data.value.size() >= 1
        // 上限對齊自訂欄位 maxLength=200（size() 與 maxLength 同以 UTF-16 code unit 計數，已在模擬器實測）；App 類儲存的是 parse 後的短值
        && request.resource.data.value.size() <= 200
        && request.resource.data.isPublic is bool;
      allow delete: if isMember() && request.auth.uid == userId;
    }

    // 個人付款方式（記帳時選用的信用卡等）：只有本人能讀寫（訪客不能寫）
    match /users/{userId}/spendMethods/{methodId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isMember()
        && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.type in ['cash', 'credit', 'mobile', 'debit', 'emoney', 'transit'];
      allow delete: if isMember() && request.auth.uid == userId;
    }

    // 個人儲蓄目標與其存提款紀錄：只有本人能讀寫（訪客不能寫）
    match /users/{userId}/savingsGoals/{goalId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isMember()
        && request.auth.uid == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 50
        && request.resource.data.targetAmount is number
        && request.resource.data.targetAmount > 0
        && request.resource.data.targetAmount < 1000000000000
        && request.resource.data.currency is string
        && (request.resource.data.targetDate == null || request.resource.data.targetDate is string);
      allow delete: if isMember() && request.auth.uid == userId;

      match /entries/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isMember()
          && request.auth.uid == userId
          && request.resource.data.type in ['save', 'withdraw']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 1000000000000
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 100
          && request.resource.data.date is string;
        allow delete: if isMember() && request.auth.uid == userId;
      }
    }

    // ===== 個人帳本（P12）=====
    // 結構與欄位見 docs/superpowers/archive/2026-11-14-p12-personal-ledger-design.md。
    // 只有本人能讀寫，訪客不能寫。貨幣只驗證是 3 碼字串：清單比對在前端，避免新增貨幣時 rules 也要同步部署。
    // 帳本文件的刪除一律由後端處理（recursiveDelete，連同子集合），客戶端不能刪，避免留下孤兒子集合。
    function isLedgerOwner(userId) {
      return isMember() && request.auth.uid == userId;
    }
    function validCurrencyCode(c) {
      return c is string && c.size() == 3;
    }
    function validMoney(v) {
      return v is number && v > 0 && v < 1000000000000;
    }
    function validBalance(v) {
      return v is number && v > -1000000000000 && v < 1000000000000;
    }

    function validLedger(d) {
      return d.keys().hasOnly(['name', 'baseCurrency', 'icon', 'color', 'archived', 'monthStartDay', 'weekStartDay', 'yearStartMonth', 'monthBudget', 'yearBudget', 'holidayAdjust', 'createdAt'])
        && d.keys().hasAll(['name', 'baseCurrency', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && validCurrencyCode(d.baseCurrency)
        && (!('icon' in d) || (d.icon is string && d.icon.size() <= 40))
        && (!('color' in d) || (d.color is string && d.color.size() <= 20))
        && (!('archived' in d) || d.archived is bool)
        // 月開始日：1–28 是每月幾日，0 是月末；週開始日：0 週日、1 週一、6 週六（見 src/features/ledger/dates.js）
        && (!('monthStartDay' in d) || (d.monthStartDay is int && d.monthStartDay >= 0 && d.monthStartDay <= 28))
        && (!('weekStartDay' in d) || (d.weekStartDay is int && d.weekStartDay in [0, 1, 6]))
        && (!('yearStartMonth' in d) || (d.yearStartMonth is int && d.yearStartMonth >= 1 && d.yearStartMonth <= 12))
        // 預算（統計幣別）：月預算、年預算總額，必須是正數；沒設就不存這個欄位
        // 固定收支遇到假日：none 不調整、before 提前到前一個工作日、after 延後到下一個工作日
        && (!('holidayAdjust' in d) || d.holidayAdjust in ['none', 'before', 'after'])
        && (!('monthBudget' in d) || validMoney(d.monthBudget))
        && (!('yearBudget' in d) || validMoney(d.yearBudget))
        && d.createdAt is timestamp;
    }

    function validAccount(d) {
      return d.keys().hasOnly(['name', 'type', 'currency', 'initialBalance', 'balance', 'kind', 'syncedCount', 'syncedNet', 'archived', 'createdAt'])
        && d.keys().hasAll(['name', 'type', 'currency', 'initialBalance', 'balance', 'kind', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.type in ['cash', 'bank', 'credit', 'emoney', 'other', 'group']
        && validCurrencyCode(d.currency)
        && validBalance(d.initialBalance)
        && validBalance(d.balance)
        && d.kind in ['normal', 'group']
        && ((d.kind == 'group') == (d.type == 'group'))
        && (!('syncedCount' in d) || (d.syncedCount is int && d.syncedCount >= 0))
        && (!('syncedNet' in d) || validBalance(d.syncedNet))
        && (!('archived' in d) || d.archived is bool)
        && d.createdAt is timestamp;
    }

    // 帳本的類別：kind、key（帳目 category 存的值）、name（選填，自訂類別必填）、order；文件 id = 'e_' 或 'i_' 加 key（支出與收入各自唯一）
    function validCategory(d, categoryId) {
      return d.keys().hasOnly(['kind', 'key', 'name', 'order', 'budget'])
        && d.keys().hasAll(['kind', 'key', 'order'])
        && d.kind in ['expense', 'income']
        && d.key is string && d.key.size() >= 1 && d.key.size() <= 30
        && categoryId == (d.kind == 'expense' ? 'e_' : 'i_') + d.key
        && (!('name' in d) || (d.name is string && d.name.size() >= 1 && d.name.size() <= 20))
        && (!d.key.matches('^c_.*') || 'name' in d)
        && (!('budget' in d) || (d.kind == 'expense' && validMoney(d.budget)))
        && d.order is int && d.order >= 0 && d.order < 1000;
    }

    // 固定收支與固定轉帳的規則：幣別固定是帳戶幣別（由前端與產生程式保證），帳戶幣別與統計幣別不同時用規則上固定的 rate
    function validRecurring(d) {
      return d.keys().hasOnly(['kind', 'name', 'accountId', 'toAccountId', 'amount', 'category', 'note', 'frequency', 'startDate', 'endDate', 'dayOfMonth', 'rate', 'enabled', 'generatedThrough', 'createdAt'])
        && d.keys().hasAll(['kind', 'name', 'accountId', 'amount', 'frequency', 'startDate', 'enabled', 'createdAt'])
        && d.kind in ['expense', 'income', 'transfer']
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.accountId is string && d.accountId.size() >= 1 && d.accountId.size() <= 120
        && validMoney(d.amount)
        && d.frequency in ['daily', 'weekly', 'monthly', 'yearly']
        && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('endDate' in d) || (d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('generatedThrough' in d) || (d.generatedThrough is string && d.generatedThrough.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('dayOfMonth' in d) || (d.dayOfMonth is int && d.dayOfMonth >= 0 && d.dayOfMonth <= 28))
        && (!('rate' in d) || validMoney(d.rate))
        && (!('category' in d) || (d.category is string && d.category.size() <= 30))
        && (!('note' in d) || (d.note is string && d.note.size() <= 50))
        && d.enabled is bool
        && d.createdAt is timestamp
        && (d.kind == 'transfer'
          ? (d.keys().hasAll(['toAccountId']) && d.toAccountId is string && d.toAccountId.size() >= 1 && d.toAccountId.size() <= 120 && d.toAccountId != d.accountId && !d.keys().hasAny(['category', 'rate']))
          : !d.keys().hasAny(['toAccountId']));
    }

    function validSource(s) {
      return s is map
        && s.keys().hasOnly(['type', 'groupId', 'kind', 'itemId', 'detached', 'edited', 'ruleId', 'scheduled'])
        && s.type in ['manual', 'fx', 'group', 'recurring']
        && (s.type != 'recurring' || s.keys().hasAll(['ruleId', 'scheduled']))
        && (!('ruleId' in s) || (s.ruleId is string && s.ruleId.size() >= 1 && s.ruleId.size() <= 100))
        && (!('scheduled' in s) || (s.scheduled is string && s.scheduled.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (s.type != 'group' || s.keys().hasAll(['groupId', 'kind', 'itemId']))
        && (!('groupId' in s) || (s.groupId is string && s.groupId.size() >= 1 && s.groupId.size() <= 100))
        && (!('kind' in s) || s.kind in ['expense', 'income'])
        && (!('itemId' in s) || (s.itemId is string && s.itemId.size() >= 1 && s.itemId.size() <= 100))
        && (!('detached' in s) || s.detached is bool)
        && (!('edited' in s) || s.edited is map);
    }

    // 收入與支出：帶匯率與換成帳本統計幣別的金額；跨幣別時帶扣款金額（對帳戶餘額的影響，帳戶幣別）
    function validEntryFields(d) {
      return d.keys().hasAll(['exchangeRate', 'baseAmount'])
        && validMoney(d.exchangeRate)
        && validMoney(d.baseAmount)
        && !d.keys().hasAny(['toAccountId', 'toAmount'])
        && (!('accountAmount' in d) || validMoney(d.accountAmount))
        && (!('accountRate' in d) || validMoney(d.accountRate));
    }

    // 轉帳：轉出金額在 amount（轉出帳戶幣別），轉入金額在 toAmount（轉入帳戶幣別），不計入收支所以沒有匯率與統計金額
    function validTransferFields(d) {
      return d.keys().hasAll(['toAccountId', 'toAmount'])
        && d.toAccountId is string && d.toAccountId.size() >= 1 && d.toAccountId.size() <= 120
        && d.toAccountId != d.accountId
        && validMoney(d.toAmount)
        && !d.keys().hasAny(['exchangeRate', 'baseAmount', 'accountAmount', 'accountRate']);
    }

    function validTransaction(d) {
      return d.keys().hasOnly(['type', 'accountId', 'amount', 'currency', 'exchangeRate', 'baseAmount', 'accountAmount', 'accountRate', 'toAccountId', 'toAmount', 'title', 'category', 'note', 'date', 'source', 'tripId', 'createdAt'])
        && d.keys().hasAll(['type', 'accountId', 'amount', 'currency', 'date', 'source', 'createdAt'])
        && d.type in ['income', 'expense', 'transfer']
        && d.accountId is string && d.accountId.size() >= 1 && d.accountId.size() <= 120
        && validMoney(d.amount)
        && validCurrencyCode(d.currency)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('title' in d) || (d.title is string && d.title.size() <= 50))
        && (!('category' in d) || (d.category is string && d.category.size() <= 30))
        && (!('note' in d) || (d.note is string && d.note.size() <= 50))
        && (!('tripId' in d) || (d.tripId is string && d.tripId.size() >= 1 && d.tripId.size() <= 100))
        && validSource(d.source)
        && d.createdAt is timestamp
        && (d.type == 'transfer' ? validTransferFields(d) : validEntryFields(d));
    }

    // 旅程（匯率頁）：帳目以選填欄位 tripId 指向旅程文件，tripId 是否存在由前端保證（rules 無法檢查）。
    // countInStats：旅程帳目是否計入個人統計（沒有或 false 就不計入）；deletedAt：有值表示在垃圾桶；
    // rows：計算機的換算列（最多 6 個幣別）；payCurrency：「實付」幣別
    function validTrip(d) {
      return d.keys().hasOnly(['name', 'currency', 'startDate', 'endDate', 'countInStats', 'deletedAt', 'rows', 'payCurrency', 'archived', 'createdAt'])
        && d.keys().hasAll(['name', 'currency', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && validCurrencyCode(d.currency)
        && (!('startDate' in d) || (d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('endDate' in d) || (d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('countInStats' in d) || d.countInStats is bool)
        && (!('deletedAt' in d) || d.deletedAt is timestamp)
        && (!('rows' in d) || (d.rows is list && d.rows.size() <= 6))
        && (!('payCurrency' in d) || validCurrencyCode(d.payCurrency))
        && (!('archived' in d) || d.archived is bool)
        && d.createdAt is timestamp;
    }

    match /users/{userId}/ledgers/{ledgerId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if isLedgerOwner(userId) && validLedger(request.resource.data);
      // 統計幣別建立後不可改（歷史帳目的 baseAmount 以它為單位）
      allow update: if isLedgerOwner(userId) && validLedger(request.resource.data)
        && request.resource.data.baseCurrency == resource.data.baseCurrency
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /accounts/{accountId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isLedgerOwner(userId) && validAccount(request.resource.data);
        // 帳戶幣別與種類建立後不可改（餘額以帳戶幣別計算）
        allow update: if isLedgerOwner(userId) && validAccount(request.resource.data)
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isLedgerOwner(userId);
      }

      match /recurring/{ruleId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isLedgerOwner(userId) && validRecurring(request.resource.data);
        allow update: if isLedgerOwner(userId) && validRecurring(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isLedgerOwner(userId);
      }

      match /trips/{tripId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isLedgerOwner(userId) && validTrip(request.resource.data);
        allow update: if isLedgerOwner(userId) && validTrip(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isLedgerOwner(userId);
      }

      match /categories/{categoryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isLedgerOwner(userId) && validCategory(request.resource.data, categoryId);
        allow delete: if isLedgerOwner(userId);
      }

      match /transactions/{txId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isLedgerOwner(userId) && validTransaction(request.resource.data);
        allow update: if isLedgerOwner(userId) && validTransaction(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isLedgerOwner(userId);
      }

      // 群組連結：文件 id 就是群組 id；linkedAt 是「不帶歷史」的分界
      match /groupLinks/{groupId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isLedgerOwner(userId)
          && request.resource.data.keys().hasOnly(['linkedAt', 'groupName'])
          && request.resource.data.keys().hasAll(['linkedAt', 'groupName'])
          && request.resource.data.linkedAt is timestamp
          && request.resource.data.groupName is string
          && request.resource.data.groupName.size() >= 1
          && request.resource.data.groupName.size() <= 50;
        allow delete: if isLedgerOwner(userId);
      }
    }

    // 個人設定（全域暱稱）：只有本人能讀寫，暱稱 1~20 字
    match /users/{userId}/settings/profile {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isMember()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20;
      allow delete: if isMember() && request.auth.uid == userId;
    }

    // 匯率換算頁的個人設定（users/{uid}/settings/fx）：全部欄位選填，沒有的欄位用預設值。
    // customRates（鍵 'JPY_TWD' → 匯率）最多 20 組；rules 無法逐項檢查值是否為正數，由前端驗證。
    function validPercent(v) {
      return v is number && v >= 0 && v <= 100;
    }
    function validFxSettings(d) {
      return d.keys().hasOnly(['decimals', 'defaultAmount', 'showSymbol', 'taxFreePercent', 'cardFeePercent', 'customRates'])
        && (!('decimals' in d) || (d.decimals is int && d.decimals >= 0 && d.decimals <= 3))
        && (!('defaultAmount' in d) || (d.defaultAmount is number && d.defaultAmount >= 0 && d.defaultAmount < 1000000000))
        && (!('showSymbol' in d) || d.showSymbol is bool)
        && (!('taxFreePercent' in d) || validPercent(d.taxFreePercent))
        && (!('cardFeePercent' in d) || validPercent(d.cardFeePercent))
        && (!('customRates' in d) || (d.customRates is map && d.customRates.size() <= 20));
    }

    match /users/{userId}/settings/fx {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isMember()
        && request.auth.uid == userId
        && validFxSettings(request.resource.data);
      allow delete: if isMember() && request.auth.uid == userId;
    }

    // 官方帳號加好友提示旗標：只記「已提示過」的時間，換裝置或清掉瀏覽器資料後也不會再跳
    match /users/{userId}/settings/oaPrompt {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if isMember()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['promptedAt'])
        && request.resource.data.promptedAt is timestamp;
      allow delete: if isMember() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // 單筆讀取：登入者持有群組 ID（邀請連結）即可讀，加入前需要先看到群組
      allow get: if request.auth != null;

      // 列表查詢：只能列出自己所屬的群組（首頁用 members array-contains 查詢）
      allow list: if request.auth != null
        && request.auth.uid in resource.data.members;

      // 建立：建立者必須是自己，且成員只有自己；群組名稱 1~50 字
      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50;

      // 更新：
      //  - 成員可更新，但不能改 createdBy，也不能新增成員（新增只能由本人加入）；budget 只有建立者能改
      //  - 成員名單只能減少一人：本人退出，或建立者移除他人（訪客不能退出，否則等於刪掉這個名字）
      //  - 非成員只能把自己加入 members（上限 50 人），並且只新增自己的 memberProfiles；訪客不能加入其他群組
      //  - 成員可新增虛擬成員（訪客名字）
      allow update: if request.auth != null && (
        (
          request.auth.uid in resource.data.members
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['budget'])
              || (request.auth.uid == resource.data.createdBy && validBudget()))
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members'])
            || (
              isMember()
              && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
              && request.resource.data.members.size() == resource.data.members.size() - 1
              && (
                resource.data.members.toSet().difference(request.resource.data.members.toSet()) == [request.auth.uid].toSet()
                || request.auth.uid == resource.data.createdBy
              )
            )
          )
        )
        ||
        (
          isMember()
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberProfiles'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 50
          && request.auth.uid in request.resource.data.members
          && request.resource.data.memberProfiles.diff(resource.data.memberProfiles).affectedKeys().hasOnly([request.auth.uid])
        )
        ||
        addsPlaceholder()
      );

      // 刪除：只有建立者
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      match /expenses/{expenseId} {
        allow read, write: if isMemberOf(groupId);
      }

      match /incomes/{incomeId} {
        allow read, write: if isMemberOf(groupId);
      }

      match /settlements/{settlementId} {
        allow read, write: if isMemberOf(groupId);
      }
    }
  }
}
