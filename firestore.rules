rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMemberOf(groupId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // 訪客（guestLogin 發的 token 帶 guest claim）只能使用自己那個名字，不能建立、加入或退出群組
    function isLineUser() {
      return request.auth != null && request.auth.token.get('guest', false) != true;
    }

    // 成員新增一位虛擬成員：members 只多一人（arrayUnion 會加在最後），id 以 p_ 開頭
    // （LINE userId 不含底線，不會撞號），且 memberProfiles 只多這一筆並標記 placeholder
    function addsPlaceholder() {
      let before = resource.data;
      let after = request.resource.data;
      let newId = after.members[after.members.size() - 1];
      return request.auth.uid in before.members
        && after.diff(before).affectedKeys().hasOnly(['members', 'memberProfiles'])
        && after.members.size() == before.members.size() + 1
        && after.members.size() <= 50
        && after.members.hasAll(before.members)
        && newId[0:2] == 'p_'
        && after.memberProfiles.diff(before.memberProfiles).addedKeys().hasOnly([newId])
        && after.memberProfiles.diff(before.memberProfiles).affectedKeys().hasOnly([newId])
        && after.memberProfiles[newId].placeholder == true
        && after.memberProfiles[newId].name is string
        && after.memberProfiles[newId].name.size() >= 1
        && after.memberProfiles[newId].name.size() <= 20;
    }

    // 個人收款方式：本人可讀寫；其他登入者只能讀「公開顯示」的（列表查詢需帶 isPublic == true）
    match /users/{userId}/paymentMethods/{methodId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || resource.data.isPublic == true);
      allow create, update: if isLineUser()
        && request.auth.uid == userId
        && request.resource.data.providerId is string
        && request.resource.data.value is string
        && request.resource.data.value.size() >= 1
        // 上限對齊自訂欄位 maxLength=200（size() 與 maxLength 同以 UTF-16 code unit 計數，已在模擬器實測）；App 類儲存的是 parse 後的短值
        && request.resource.data.value.size() <= 200
        && request.resource.data.isPublic is bool;
      allow delete: if isLineUser() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // 單筆讀取：登入者持有群組 ID（邀請連結）即可讀，加入前需要先看到群組
      allow get: if request.auth != null;

      // 列表查詢：只能列出自己所屬的群組（首頁用 members array-contains 查詢）
      allow list: if request.auth != null
        && request.auth.uid in resource.data.members;

      // 建立：建立者必須是自己，且成員只有自己；群組名稱 1~50 字
      allow create: if isLineUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50;

      // 更新：
      //  - 成員可更新，但不能改 createdBy，也不能新增成員（新增只能由本人加入）
      //  - 成員名單只能減少一人：本人退出，或建立者移除他人（訪客不能退出，否則等於刪掉這個名字）
      //  - 非成員只能把自己加入 members（上限 50 人），並且只新增自己的 memberProfiles；訪客不能加入其他群組
      //  - 成員可新增虛擬成員（訪客名字）
      allow update: if request.auth != null && (
        (
          request.auth.uid in resource.data.members
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members'])
            || (
              isLineUser()
              && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
              && request.resource.data.members.size() == resource.data.members.size() - 1
              && (
                resource.data.members.toSet().difference(request.resource.data.members.toSet()) == [request.auth.uid].toSet()
                || request.auth.uid == resource.data.createdBy
              )
            )
          )
        )
        ||
        (
          isLineUser()
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberProfiles'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 50
          && request.auth.uid in request.resource.data.members
          && request.resource.data.memberProfiles.diff(resource.data.memberProfiles).affectedKeys().hasOnly([request.auth.uid])
        )
        ||
        addsPlaceholder()
      );

      // 刪除：只有建立者
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      match /expenses/{expenseId} {
        allow read, write: if isMemberOf(groupId);
      }

      match /settlements/{settlementId} {
        allow read, write: if isMemberOf(groupId);
      }
    }
  }
}
